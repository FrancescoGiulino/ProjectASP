using UnityEngine;
using System;
using System.Collections.Generic;
using ThinkEngine.Mappers;
using static ThinkEngine.Mappers.OperationContainer;
namespace ThinkEngine
{
	public class worldInformationManagerSensor_EnemyTaskDistance_Distances : Sensor
	{
		private int counter;
		private object specificValue;
		private Operation operation;
		private BasicTypeMapper mapper;
		private List<List<float>> values = new List<List<float>>();
		public override void Initialize(SensorConfiguration sensorConfiguration)
		{
			this.gameObject = sensorConfiguration.gameObject;
			ready = true;
			int index = gameObject.GetInstanceID();
			mapper = (BasicTypeMapper)MapperManager.GetMapper(typeof(float));
			operation = mapper.OperationList()[0];
			counter = 0;
			mappingTemplate = "worldInformationManagerSensor_EnemyTaskDistance_Distances(worldInformationManager,objectIndex("+index+"),{1},{0})." + Environment.NewLine;
		}
		public override void Destroy()
		{
		}
		public override void Update()
		{
			if(!ready)
			{
				return;
			}
			if(!invariant || first)
			{
				first = false;
				MessageBus MessageBus_1 = gameObject.GetComponent<MessageBus>();
				if(MessageBus_1 == null)
				{
					values.Clear();
					return;
				}
				List<float> EnemyTaskDistance_Distances_2 = MessageBus_1.EnemyTaskDistance_Distances;
				if(EnemyTaskDistance_Distances_2 == null)
				{
					values.Clear();
					return;
				}
				else if(EnemyTaskDistance_Distances_2.Count > values.Count)
				{
					for(int i = values.Count; i < EnemyTaskDistance_Distances_2.Count; i++)
					{
						values.Add(new List<float>());
					}
				}
				else if(EnemyTaskDistance_Distances_2.Count < values.Count)
				{
					for(int i = EnemyTaskDistance_Distances_2.Count; i < values.Count; i++)
					{
						values.RemoveAt(values.Count - 1);
					}
				}
				for(int i_2 = 0; i_2 < EnemyTaskDistance_Distances_2.Count; i_2++)
				{
					if (values[i_2].Count == 1)
					{
						values[i_2].RemoveAt(0);
					}
					values[i_2].Add(EnemyTaskDistance_Distances_2[i_2]);
				}
			}
		}
		public override string Map()
		{
			string mapping = string.Empty;
			for(int i0 = 0; i0 < values.Count; i0++)
			{
				object operationResult = operation(values[i0], specificValue, counter);
				if(operationResult != null)
				{
					mapping = string.Concat(mapping, string.Format(mappingTemplate, BasicTypeMapper.GetMapper(operationResult.GetType()).BasicMap(operationResult),i0));
				}
				else
				{
					mapping = string.Concat(mapping, string.Format("{0}", Environment.NewLine));
				}
			}
			return mapping;
		}
	}
}